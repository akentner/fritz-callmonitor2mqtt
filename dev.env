# Development Environment Configuration
# Source this file: source dev.env

# FRITZ!Box settings
export FRITZ_CALLMONITOR_FRITZBOX_HOST=192.168.178.1
export FRITZ_CALLMONITOR_FRITZBOX_PORT=1012

# MQTT broker settings (no credentials needed)
export FRITZ_CALLMONITOR_MQTT_BROKER=192.168.178.3
export FRITZ_CALLMONITOR_MQTT_PORT=1883
# No username/password needed for dev environment
# export FRITZ_CALLMONITOR_MQTT_USERNAME=
# export FRITZ_CALLMONITOR_MQTT_PASSWORD=

# Client settings
export FRITZ_CALLMONITOR_MQTT_CLIENT_ID=fritz-callmonitor2mqtt-dev2
export FRITZ_CALLMONITOR_MQTT_TOPIC_PREFIX=fritz/callmonitor/dev
export FRITZ_CALLMONITOR_MQTT_QOS=1
export FRITZ_CALLMONITOR_MQTT_RETAIN=true

# Connection settings
export FRITZ_CALLMONITOR_MQTT_KEEP_ALIVE=60s
export FRITZ_CALLMONITOR_MQTT_CONNECT_TIMEOUT=30s

# Application settings
export FRITZ_CALLMONITOR_APP_LOG_LEVEL=debug
export FRITZ_CALLMONITOR_APP_CALL_HISTORY_SIZE=50
export FRITZ_CALLMONITOR_APP_MSN_CALL_HISTORY_SIZE=30
export FRITZ_CALLMONITOR_APP_RECONNECT_DELAY=5s
export FRITZ_CALLMONITOR_APP_HEALTH_CHECK_PORT=8080
export FRITZ_CALLMONITOR_APP_TIMEZONE=Europe/Berlin

# PBX
export FRITZ_CALLMONITOR_PBX_MSN=990133,990134,990135,990136,3698237
export FRITZ_CALLMONITOR_PBX_COUNTRY_CODE=49
export FRITZ_CALLMONITOR_PBX_LOCAL_AREA_CODE=6181

# Database
export FRITZ_CALLMONITOR_DATABASE_DATA_DIR=./data

