# Fritz!Box Callmonitor to MQTT Bridge Configuration
# Copy this file to config.yml and customize as needed

# Fritz!Box settings
FRITZ_CALLMONITOR_FRITZBOX_HOST=fritz.box
FRITZ_CALLMONITOR_FRITZBOX_PORT=1012

# MQTT broker settings
FRITZ_CALLMONITOR_MQTT_BROKER=localhost
FRITZ_CALLMONITOR_MQTT_PORT=1883
# FRITZ_CALLMONITOR_MQTT_USERNAME=your_username
# FRITZ_CALLMONITOR_MQTT_PASSWORD=your_password
FRITZ_CALLMONITOR_MQTT_CLIENT_ID=fritz-callmonitor2mqtt
FRITZ_CALLMONITOR_MQTT_TOPIC_PREFIX=fritz/callmonitor
FRITZ_CALLMONITOR_MQTT_QOS=1
FRITZ_CALLMONITOR_MQTT_RETAIN=true

# Application settings
FRITZ_CALLMONITOR_APP_LOG_LEVEL=info
FRITZ_CALLMONITOR_APP_CALL_HISTORY_SIZE=50
FRITZ_CALLMONITOR_APP_MSN_CALL_HISTORY_SIZE=30
FRITZ_CALLMONITOR_APP_RECONNECT_DELAY=10s
FRITZ_CALLMONITOR_APP_HEALTH_CHECK_PORT=8080

# Database settings
FRITZ_CALLMONITOR_DATABASE_DATA_DIR=./data

# PBX settings
FRITZ_CALLMONITOR_PBX_COUNTRY_CODE=49
FRITZ_CALLMONITOR_PBX_LOCAL_AREA_CODE=6181
FRITZ_CALLMONITOR_PBX_MSN=1234567890,0987654321

# Extension Configuration (Fritz!Box Nebenstellen)
# Configure internal extensions with names and types
# Format: FRITZ_CALLMONITOR_PBX_EXTENSION_<INDEX>_<PROPERTY>
# 
# Supported extension types (auto-detected if not specified):
# - DECT: DECT handsets (61x range)
# - VOIP: VoIP phones (62x, 63x range)
# - VOICEBOX: Answering machines (60x range)
# - ANALOG: Analog phones (1-99 range)
# - UNKNOWN: Unknown/unsupported type

# Example extension configurations:
# 
# IMPORTANT: Systematic Extension Number Mapping
# Fritz!Box uses systematic internal number ranges for extension types:
# - **600-**609: VOICEBOX -> Events 40-49
# - **610-**619: DECT -> Events 10-19  
# - **620-**629: VOIP -> Events 20-29
# - Other ranges: UNKNOWN
#
# GUI 6xx extensions: Remove leading "6" for event number
# - GUI 621 -> Event 21 -> Type VOIP (620-629 range)
# - GUI 615 -> Event 15 -> Type DECT (610-619 range)
# - Internal **600 -> Event 40 -> Type VOICEBOX (600-609 range)
#
# FRITZ_CALLMONITOR_PBX_EXTENSION_0_NUMBER=621
# FRITZ_CALLMONITOR_PBX_EXTENSION_0_NAME=Büro VoIP  
# FRITZ_CALLMONITOR_PBX_EXTENSION_0_TYPE=VOIP
#
# FRITZ_CALLMONITOR_PBX_EXTENSION_1_NUMBER=615
# FRITZ_CALLMONITOR_PBX_EXTENSION_1_NAME=Wohnzimmer DECT
# FRITZ_CALLMONITOR_PBX_EXTENSION_1_TYPE=DECT
#
# FRITZ_CALLMONITOR_PBX_EXTENSION_2_NUMBER=**600
# FRITZ_CALLMONITOR_PBX_EXTENSION_2_NAME=Anrufbeantworter Wohnzimmer (Internal **600 -> Event 40)
# FRITZ_CALLMONITOR_PBX_EXTENSION_2_TYPE=VOICEBOX
#
# FRITZ_CALLMONITOR_PBX_EXTENSION_3_NUMBER=**605
# FRITZ_CALLMONITOR_PBX_EXTENSION_3_NAME=Voicebox System (Internal **605 -> Event 45)  
# FRITZ_CALLMONITOR_PBX_EXTENSION_3_TYPE=VOICEBOX
